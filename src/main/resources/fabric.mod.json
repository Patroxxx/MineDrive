{
	"schemaVersion": 1,
	"id": "minedrive",
	"version": "${version}",
	"name": "MineDrive",
	"description": "Minecraft cloud save system using the power of Google Drive!\n\n-\n\nFork of ModMonster's MineGIT\n",
	"authors": [
		"JustPatrox",
		"ModMonster"
	],
	"contact": {
		"homepage": "https://github.com/Patroxxx/MineDrive",
		"issues": "https://github.com/Patroxxx/MineDrive/issues"
	},
	"license": "MIT",
	"icon": "assets/minegit/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"ca.justpatrox.minedrive.MineDRIVE"
		],
        "modmenu": [
            "ca.justpatrox.minedrive.extra.ModMenuImplementation"
        ]
	},
	"mixins": [
		{
			"config": "minegit.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": ">=26.1-pre.1",
		"java": ">=25",
		"fabric-api": "*"
	},
	"conflicts": {
		"fastquit": "*"
	},
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/HYs4rhPmnm",
                "modmenu.issues": "https://github.com/Patroxxx/MineDrive/issues"
            }
        }
    }
}
